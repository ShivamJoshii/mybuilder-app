# Local: values printed by `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# File storage (S3 API). Local: values from `supabase status` (S3_PROTOCOL_*). Production: Cloudflare R2.
STORAGE_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_REGION=local
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=files
# Email. Without POSTMARK_SERVER_TOKEN outgoing mail stays queued (nothing is sent).
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=notifications@mybuilder.ca
INBOUND_DOMAIN=in.mybuilder.ca
# Postmark inbound webhook URL: https://<site>/api/inbound/postmark with basic auth password = this secret. Change in production.
INBOUND_WEBHOOK_SECRET=dev-inbound-secret
